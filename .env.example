# Optional shared storage for anonymous decision statistics and abuse rate limits.
# The app runs fully without these; community stats simply stay hidden.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy notification integration settings. Local reminders do not require these.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Web Push delivery: subscription storage + dispatcher authentication.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NOTIFICATION_CRON_SECRET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Studio narration (scripts/narration/generate.ts). Azure Speech free tier (F0) key + region, e.g. eastus.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
