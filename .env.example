# Shared storage is required for production rate limits and decision statistics.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-side AI key. Users may also provide their own Gemini key.
GEMINI_API_KEY=

# Required to enable server-generated narration.
ELEVENLABS_API_KEY=

# Legacy notification integration settings. Local reminders do not require these.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
