# ElevenLabs Text-to-Speech. Server only. Never prefix this with VITE_.
# Revoke any key that was previously shipped in the client, then paste the new one here
# and in the Vercel project environment.
ELEVENLABS_API_KEY=

# Web Push. Generate a real pair and set both in Vercel. The public key is safe in the client.
# Leave blank to skip push subscription (local reminders still work).
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase push_subscriptions. Confirm row-level security allows anon insert only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API Key for dynamic real-life faith dilemmas & deep wisdom insights
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=
